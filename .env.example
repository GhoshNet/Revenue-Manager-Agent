# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# Local docker Postgres (Quick start in README)
DATABASE_URL=postgresql://hackathon:hackathon@localhost:5432/hotel_hackathon

# Data site to scrape
DATA_SITE_URL=https://otel-hackathon-data-site.vercel.app

# LLM (Phase 3+). The model is pluggable — see agent/models.py.
# Pick the default model the agent/UI starts with (a registry id):
#   claude-sonnet-4-6 | claude-haiku-4-5 | gemini-flash | gemini-flash-lite |
#   groq-llama-3.3-70b |
#   groq-gpt-oss-20b  | ollama-qwen2.5   | ollama-llama3.1
AGENT_MODEL_ID=claude-sonnet-4-6

# Anthropic (paid). Needed for the claude-* models.
ANTHROPIC_API_KEY=

# Google Gemini (free tier). Needed for the gemini-* models.
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq (free tier, open-weight Llama / GPT-OSS). Needed for groq-* models.
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Ollama (fully local, free, no key) — needs the Ollama app + `ollama pull qwen2.5`.
# OLLAMA_BASE_URL=http://localhost:11434

# Agent UI basic auth. Required when hosted (the server refuses to start
# without them); locally they default to gm / harbour.
APP_USERNAME=
APP_PASSWORD=

# Optional guardrail limits (defaults shown) — see SECURITY.md.
# MAX_MESSAGE_CHARS=2000
# RATE_LIMIT_PER_MIN=10
# DAILY_REQUEST_CAP=300
# REQUEST_TIMEOUT_S=240
# AGENT_RECURSION_LIMIT=150
# DB_STATEMENT_TIMEOUT_MS=10000

# Optional: pin "now" for booking-pace windows (defaults to the latest load time).
# DATA_AS_OF=2026-06-21T02:19:05Z
